<section class="sec container page-narrow" style="max-width:440px">
  <h1 class="cart-title">Nouveau mot de passe</h1>
  {%- form 'reset_customer_password', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="rp">Nouveau mot de passe</label><input type="password" id="rp" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="rpc">Confirmer</label><input type="password" id="rpc" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--dark btn--block" type="submit">Enregistrer</button>
  {%- endform -%}
</section>
