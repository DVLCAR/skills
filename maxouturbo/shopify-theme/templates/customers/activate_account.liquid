<section class="sec container page-narrow" style="max-width:440px">
  <h1 class="cart-title">Activer mon compte</h1>
  <p class="muted">Choisis un mot de passe pour activer ton compte.</p>
  {%- form 'activate_customer_password', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ap">Mot de passe</label><input type="password" id="ap" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="apc">Confirmer</label><input type="password" id="apc" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--dark btn--block" type="submit">Activer</button>
    <button class="btn btn--light btn--block" type="submit" name="decline" style="margin-top:.6rem">Refuser l'invitation</button>
  {%- endform -%}
</section>
