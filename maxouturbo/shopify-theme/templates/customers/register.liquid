<section class="sec container page-narrow" style="max-width:440px">
  <h1 class="cart-title">Créer un compte</h1>
  {%- form 'create_customer', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="fn">Prénom</label><input type="text" id="fn" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field"><label for="ln">Nom</label><input type="text" id="ln" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field"><label for="em">E-mail</label><input type="email" id="em" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="pw">Mot de passe</label><input type="password" id="pw" name="customer[password]" autocomplete="new-password" required></div>
    <button class="btn btn--dark btn--block" type="submit">Créer mon compte</button>
  {%- endform -%}
  <p class="account-alt">Déjà client ? <a href="{{ routes.account_login_url }}">Se connecter</a></p>
</section>
