<section class="sec container page-narrow" style="max-width:440px">
  <h1 class="cart-title">Connexion</h1>
  {%- form 'customer_login', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ce">E-mail</label><input type="email" id="ce" name="customer[email]" autocomplete="email" required></div>
    {%- if form.password_needed -%}
    <div class="field"><label for="cp">Mot de passe</label><input type="password" id="cp" name="customer[password]" autocomplete="current-password"></div>
    {%- endif -%}
    <button class="btn btn--dark btn--block" type="submit">Se connecter</button>
  {%- endform -%}

  <details class="account-details">
    <summary>Mot de passe oublié ?</summary>
    {%- form 'recover_customer_password', class: 'account-form' -%}
      {{ form.errors | default_errors }}
      {%- if form.posted_successfully? -%}<p class="account-ok">Un e-mail de réinitialisation t'a été envoyé.</p>{%- endif -%}
      <div class="field"><label for="re">E-mail</label><input type="email" id="re" name="email" required></div>
      <button class="btn btn--light btn--block" type="submit">Réinitialiser</button>
    {%- endform -%}
  </details>

  <p class="account-alt">Pas encore de compte ? <a href="{{ routes.account_register_url }}">Créer un compte</a></p>
</section>
