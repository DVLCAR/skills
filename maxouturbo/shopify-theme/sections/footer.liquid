<section class="promise" aria-label="Nos engagements">
  <div class="container promise__grid">
    <div class="promise__it"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg><div><b>{{ section.settings.p1_title | default: 'Livraison gratuite' }}</b><span>{{ section.settings.p1_text | default: "Dès 50 € d'achat, en France." }}</span></div></div>
    <div class="promise__it"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><div><b>{{ section.settings.p2_title | default: 'Service client' }}</b><span>{{ section.settings.p2_text | default: 'Réponse par mail sous 72h ouvrés.' }}</span></div></div>
    <div class="promise__it"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="m9 12 2 2 4-4"/></svg><div><b>{{ section.settings.p3_title | default: 'Paiement sécurisé' }}</b><span>{{ section.settings.p3_text | default: 'Infos de paiement chiffrées.' }}</span></div></div>
    <div class="promise__it"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 6v6c0 5 4 8 9 10 5-2 9-5 9-10V6z"/><path d="M8 11h8M8 14h8"/></svg><div><b>{{ section.settings.p4_title | default: 'Emballage protégé' }}</b><span>{{ section.settings.p4_text | default: 'Filmé de la boîte au transporteur.' }}</span></div></div>
  </div>
</section>

<footer class="footer" id="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a class="brand" href="{{ routes.root_url }}"><span class="brand__row"><span class="brand__t">{{ section.settings.brand_main | default: 'TMAX' }}</span><span class="brand__s">{{ section.settings.brand_accent | default: 'Shop' }}</span></span><span class="brand__by">{{ section.settings.brand_sub | default: 'by MaxouTurbo' }}</span></a>
      {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline }}</p>{%- endif -%}
      <div class="socials">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4c.5 3 2.5 4.5 5 4.7V12c-2 0-3.7-.6-5-1.6V15a5.5 5.5 0 1 1-5.5-5.5c.4 0 .7 0 1 .1v3.1a2.4 2.4 0 1 0 1.5 2.3V4z"/></svg></a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v6h4v-6h3l1-4h-4V8a1 1 0 0 1 1-1z"/></svg></a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="2.5" y="6" width="19" height="12" rx="4"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
      <div class="fcol" {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        {%- if block.settings.menu != blank -%}
          {%- for l in linklists[block.settings.menu].links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  <div class="container footer__locale">
    {%- form 'localization' -%}
      {%- if localization.available_languages.size > 1 -%}
      <div class="select"><select name="locale_code" aria-label="Langue" onchange="this.form.submit()">
        {%- for lang in localization.available_languages -%}<option value="{{ lang.iso_code }}"{% if lang.iso_code == localization.language.iso_code %} selected{% endif %}>{{ lang.endonym_name | capitalize }}</option>{%- endfor -%}
      </select></div>
      {%- endif -%}
      {%- if localization.available_countries.size > 1 -%}
      <div class="select"><select name="country_code" aria-label="Pays / devise" onchange="this.form.submit()">
        {%- for c in localization.available_countries -%}<option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>{%- endfor -%}
      </select></div>
      {%- endif -%}
    {%- endform -%}
  </div>
  {%- endif -%}

  <div class="container footer__bottom">
    <div class="footer__legal">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if section.settings.legal_menu != blank -%}
        {%- for l in linklists[section.settings.legal_menu].links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
      {%- endif -%}
    </div>
    <div class="pays" aria-label="Moyens de paiement">
      {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'pay-svg' }}{%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "brand_main", "label": "Wordmark texte 1", "default": "TMAX" },
    { "type": "text", "id": "brand_accent", "label": "Wordmark texte 2", "default": "Shop" },
    { "type": "text", "id": "brand_sub", "label": "Wordmark sous-texte", "default": "by MaxouTurbo" },
    { "type": "textarea", "id": "tagline", "label": "Description", "default": "La boutique en ligne des pièces & accessoires TMAX, par l'atelier MaxouTurbo — Auriol (13), près de Marseille." },
    { "type": "link_list", "id": "legal_menu", "label": "Menu bas de page (légal)" },
    { "type": "header", "content": "Blocs réassurance (icônes)" },
    { "type": "text", "id": "p1_title", "label": "Bloc 1 titre", "default": "Livraison gratuite" },
    { "type": "text", "id": "p1_text", "label": "Bloc 1 texte", "default": "Dès 50 € d'achat, en France." },
    { "type": "text", "id": "p2_title", "label": "Bloc 2 titre", "default": "Service client" },
    { "type": "text", "id": "p2_text", "label": "Bloc 2 texte", "default": "Réponse par mail sous 72h ouvrés." },
    { "type": "text", "id": "p3_title", "label": "Bloc 3 titre", "default": "Paiement sécurisé" },
    { "type": "text", "id": "p3_text", "label": "Bloc 3 texte", "default": "Infos de paiement chiffrées." },
    { "type": "text", "id": "p4_title", "label": "Bloc 4 titre", "default": "Emballage protégé" },
    { "type": "text", "id": "p4_text", "label": "Bloc 4 texte", "default": "Filmé de la boîte au transporteur." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Pied de page",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Boutique" } },
        { "type": "menu", "settings": { "heading": "Catégories" } },
        { "type": "menu", "settings": { "heading": "Aide" } }
      ]
    }
  ]
}
{% endschema %}
