<section class="sec--tight container" aria-label="{{ section.settings.title | default: 'Nos marques' | escape }}">
  <div class="brands__row reveal">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <div class="brandcard" {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'brand-logo-img' }}</div>
      {%- else -%}
        <div class="brandcard" {{ block.shopify_attributes }}>{{ block.settings.name }}</div>
      {%- endif -%}
    {%- else -%}
      {%- assign demo_brands = "AKRAPOVIČ,MALOSSI,POLINI,BREMBO,PUIG,RIZOMA,SC-PROJECT,BCD,QUAD LOCK,MOTUL" | split: ',' -%}
      {%- for d in demo_brands -%}<div class="brandcard">{{ d }}</div>{%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marques",
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nom"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo (optionnel)"
        }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "Marques",
      "blocks": [
        {
