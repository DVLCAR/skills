<section class="sec--tight container" id="explore">
  <div class="explore reveal">
    <div class="explore__in">
      <div class="explore__copy">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        <div class="explore__chips">
          {%- for block in section.blocks -%}<span class="chip">{{ block.settings.label }}</span>{%- else -%}<span class="chip">Variateur &amp; transmission</span><span class="chip">Échappement</span><span class="chip">Freinage</span><span class="chip">Esthétique &amp; carbone</span><span class="chip">Cockpit</span>{%- endfor -%}
        </div>
      </div>
      <div class="stage" role="group" aria-label="Schéma interactif">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: '', class: 'stage__img' }}
        {%- else -%}
          <svg class="stage__svg" viewBox="0 0 440 230" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="104" cy="178" r="46"/><circle cx="104" cy="178" r="15"/><circle cx="344" cy="178" r="46"/><circle cx="344" cy="178" r="15"/>
            <path d="M150 178C150 152 130 140 104 140"/><path d="M290 178C290 152 310 140 344 140"/>
            <path d="M72 140C58 120 70 106 94 104L166 102C176 86 192 82 210 82L262 82C276 64 300 60 314 66"/>
            <path d="M94 120L176 118"/><path d="M166 134L262 132"/><path d="M314 66C326 82 322 112 300 134"/><path d="M314 66C338 56 350 76 342 98"/><path d="M300 70L326 52M320 52H346"/><path d="M300 104l14 6-14 6"/>
          </svg>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <a class="hs" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            <span class="hs__dot"></span>
            <span class="hs__pop"><b>{{ block.settings.label }}</b><span>{{ block.settings.sub }}</span><span class="go">Voir les pièces →</span></span>
          </a>
        {%- else -%}
          <a class="hs" style="left:33%;top:64%"><span class="hs__dot"></span><span class="hs__pop"><b>Variateur &amp; transmission</b><span>Malossi · Polini</span><span class="go">Voir les pièces →</span></span></a>
          <a class="hs" style="left:62%;top:82%"><span class="hs__dot"></span><span class="hs__pop"><b>Échappement</b><span>Akrapovič · SC-Project</span><span class="go">Voir les pièces →</span></span></a>
          <a class="hs" style="left:78%;top:80%"><span class="hs__dot"></span><span class="hs__pop"><b>Freinage</b><span>Brembo · disques</span><span class="go">Voir les pièces →</span></span></a>
          <a class="hs" style="left:70%;top:34%"><span class="hs__dot"></span><span class="hs__pop"><b>Esthétique &amp; carbone</b><span>Bulles · carénages</span><span class="go">Voir les pièces →</span></span></a>
          <a class="hs" style="left:80%;top:22%"><span class="hs__dot"></span><span class="hs__pop"><b>Cockpit</b><span>Support tél · Quad Lock</span><span class="go">Voir les pièces →</span></span></a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Explore ton TMAX",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Nouveau · interactif"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Explore ton TMAX"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Clique sur une zone de la moto pour voir les pièces compatibles. La bonne catégorie en un clic."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image du scooter (optionnel, sinon schéma dessiné)"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Point cliquable",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Titre",
          "default": "Échappement"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Sous-texte",
          "default": "Akrapovič · SC-Project"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (collection)"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Position X (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 60
        },
        {
          "type": "range",
          "id": "y",
          "label": "Position Y (%)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 60
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Explore ton TMAX",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "label": "Variateur & transmission",
            "sub": "Malossi · Polini",
            "x": 33,
            "y": 64
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "label": "Échappement",
            "sub": "Akrapovič · SC-Project",
            "x": 62,
            "y": 82
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "label": "Freinage",
            "sub": "Brembo · disques",
            "x": 78,
            "y": 80
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "label": "Esthétique & carbone",
            "sub": "Bulles · carénages",
            "x": 70,
            "y": 34
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "label": "Cockpit",
            "sub": "Support tél · Quad Lock",
            "x": 80,
            "y": 22
          }
        }
      ]
    }
  ]
}
{% endschema %}
