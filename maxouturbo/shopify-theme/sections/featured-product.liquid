{%- assign fp = null -%}
{%- if section.settings.product != blank -%}{%- assign fp = all_products[section.settings.product] -%}{%- endif -%}
<section class="sec--tight container">
  <div class="feature reveal">
    <div class="feature__in">
      <div class="feature__media">
        {%- if section.settings.badge_text != blank -%}
        <div class="spin" aria-hidden="true">
          <svg class="spin__svg" viewBox="0 0 120 120"><defs><path id="ring-{{ section.id }}" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"/></defs><text font-size="10.5" font-weight="700" letter-spacing="3.4" fill="currentColor"><textPath href="#ring-{{ section.id }}" startOffset="0">{{ section.settings.badge_text }} · {{ section.settings.badge_text }} · </textPath></text></svg>
          <span class="spin__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1zM7 11l4-8a2 2 0 0 1 2 2v3h5.5a2 2 0 0 1 2 2.3l-1.3 7a2 2 0 0 1-2 1.7H7"/></svg></span>
        </div>
        {%- endif -%}
        {%- if fp.featured_media -%}
          {{ fp.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: fp.title, class: 'feature__img' }}
        {%- else -%}
          <svg class="art" viewBox="0 0 220 150" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M40 96c-14-6-20-20-14-34 12 2 22 10 26 24"/><path d="M52 86l16-30 10 6-14 32"/><path d="M180 96c14-6 20-20 14-34-12 2-22 10-26 24"/><path d="M168 86l-16-30-10 6 14 32"/><path d="M74 100h72"/></svg>
        {%- endif -%}
      </div>
      <div class="feature__body">
        {%- if fp.id -%}
          {%- if fp.vendor != blank -%}<span class="card__brand">{{ fp.vendor }}</span>{%- endif -%}
          <h3>{{ fp.title }}</h3>
          {%- form 'product', fp, class: 'feature-form js-product-form' -%}
            {%- unless fp.has_only_default_variant -%}
            <div class="variant">
              <div class="variant__label">{{ fp.options_with_values.first.name }}</div>
              <div class="select"><select name="id" id="featVariant-{{ section.id }}">
                {%- for variant in fp.variants -%}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{%- endfor -%}
              </select></div>
            </div>
            {%- else -%}
            <input type="hidden" name="id" value="{{ fp.selected_or_first_available_variant.id }}">
            {%- endunless -%}
            <div class="feature__price"><span class="now">{{ fp.price | money }}</span>{%- if fp.compare_at_price > fp.price -%}<span class="feat-was">{{ fp.compare_at_price | money }}</span>{%- endif -%}</div>
            <button class="btn btn--dark btn--block" type="submit"{% unless fp.available %} disabled{% endunless %}>{% if fp.available %}Ajouter au panier{% else %}Épuisé{% endif %}</button>
          {%- endform -%}
          <div class="feature__foot"><a class="link-arrow" href="{{ fp.url }}">Afficher tous les détails <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
        {%- else -%}
          <span class="card__brand">Produit vedette</span>
          <h3>Choisis un produit dans le thème</h3>
          <p class="hero__sub">Personnalise cette section (Produit vedette) et sélectionne le produit à mettre en avant.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produit vedette",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "text", "id": "badge_text", "label": "Texte pastille tournante", "default": "NOUVEAUTÉ · 2026" }
  ],
  "presets": [{ "name": "Produit vedette" }]
}
{% endschema %}
