<section class="sec--tight container">
  <div class="news reveal">
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', class: 'news-form', id: 'news-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" id="newsEmail" placeholder="{{ section.settings.placeholder | default: 'ton@email.fr' }}" aria-label="Adresse e-mail" required autocorrect="off" autocapitalize="off">
      <button class="btn btn--blue" type="submit" name="commit">{{ section.settings.button | default: "Je m'inscris" }}</button>
      {%- if form.posted_successfully? -%}
        <div class="news__ok show"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> {{ section.settings.success | default: 'Merci ! Ton code de bienvenue arrive par e-mail.' }}</div>
      {%- endif -%}
      {%- if form.errors -%}
        <small style="color:var(--red)">{{ form.errors | default_errors }}</small>
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.small != blank -%}<small>{{ section.settings.small }}</small>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "−10 % sur ta première commande" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Nouveautés, promos et bons plans TMAX. On écrit peu, mais bien." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "ton@email.fr" },
    { "type": "text", "id": "button", "label": "Bouton", "default": "Je m'inscris" },
    { "type": "text", "id": "success", "label": "Message de succès", "default": "Merci ! Ton code de bienvenue arrive par e-mail." },
    { "type": "text", "id": "small", "label": "Mention", "default": "Désinscription en un clic. Aucune revente de données." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
