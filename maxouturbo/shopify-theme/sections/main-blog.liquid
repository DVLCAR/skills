{%- paginate blog.articles by 12 -%}
<section class="sec container">
  <h1 class="cart-title">{{ blog.title }}</h1>
  <div class="grid" style="margin-top:1.6rem">
    {%- for article in blog.articles -%}
      <a class="cc" href="{{ article.url }}">
        <div class="cc__media">{%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title, class: 'card__img' }}{%- endif -%}</div>
        <div class="card__info">
          <span class="card__brand">{{ article.published_at | date: '%d %b %Y' }}</span>
          <span class="card__title">{{ article.title }}</span>
          {%- if article.excerpt_or_content != blank -%}<p class="cc__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>{%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
