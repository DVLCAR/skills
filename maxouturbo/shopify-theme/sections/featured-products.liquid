{%- assign is_carousel = false -%}
{%- if section.settings.layout == 'carousel' -%}{%- assign is_carousel = true -%}{%- endif -%}
<section class="sec container">
  <div class="sechead reveal">
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="right">
      {%- if section.blocks.size > 1 -%}
      <div class="mtabs" role="tablist" data-tabgroup="{{ section.id }}">
        {%- for block in section.blocks -%}
          <button class="mtab" role="tab" type="button" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-target="{{ section.id }}-{{ forloop.index }}">{{ block.settings.label }}</button>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if is_carousel -%}
      <div class="arrows"><button type="button" aria-label="Précédent" data-scroll="-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button><button type="button" aria-label="Suivant" data-scroll="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button></div>
      {%- endif -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- assign coll = collections[block.settings.collection] -%}
    <div class="{% if is_carousel %}scroller{% else %}grid{% endif %} reveal" data-tabpanel="{{ section.id }}-{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>
      {%- if coll and coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.count -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.count) -%}
          <article class="card"><div class="card__media"><svg class="art" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><rect x="30" y="50" width="56" height="22" rx="11"/><path d="M86 55l12 3v6l-12 3M30 61H16"/></svg></div><div class="card__info"><span class="card__brand">Marque</span><span class="card__title">Sélectionne une collection dans le thème</span><div class="card__price"><span class="now">—</span></div></div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="{% if is_carousel %}scroller{% else %}grid{% endif %} reveal">
      {%- for i in (1..section.settings.count) -%}
        <article class="card"><div class="card__media"><svg class="art" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><rect x="30" y="50" width="56" height="22" rx="11"/><path d="M86 55l12 3v6l-12 3M30 61H16"/></svg></div><div class="card__info"><span class="card__brand">Marque</span><span class="card__title">Ajoute une collection à cet onglet</span><div class="card__price"><span class="now">—</span></div></div></article>
      {%- endfor -%}
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Produits vedettes",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "En vedette"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        {
          "value": "grid",
          "label": "Grille"
        },
        {
          "value": "carousel",
          "label": "Carrousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Produits par onglet",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Onglet (modèle)",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libellé onglet",
          "default": "TMAX 560"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "En vedette",
      "settings": {
        "heading": "En vedette",
        "layout": "grid"
      },
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "TMAX 560"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "TMAX 530"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "TMAX 500"
          }
        }
      ]
    },
    {
      "name": "Support téléphone (carrousel)",
      "settings": {
        "heading": "Support téléphone",
        "layout": "carousel"
      },
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "TMAX 560"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "TMAX 530"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "TMAX 500"
          }
        }
      ]
    }
  ]
}
{% endschema %}
